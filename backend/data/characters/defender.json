  "dialogue": {
    "greeting": [
      { "id": "defender_greeting_01", "text": "Бойся меня, если посмеешь!", "weight": 1.6, "cooldown": 10 },
      { "id": "defender_greeting_02", "text": "Ты много видел котов в сапогах? Только честно.", "weight": 1.5, "cooldown": 10 },
      { "id": "defender_greeting_03", "text": "Сеньор, шпага пока в ножнах. Пока.", "weight": 1.3, "cooldown": 9 }
    ],
    "opening": [
      { "id": "defender_opening_01", "text": "Сначала сапоги, потом шпага. У каждого боя есть порядок.", "weight": 1.3, "cooldown": 9, "min_move": 1, "max_move": 10 },
      { "id": "defender_opening_02", "text": "Ты много видел котов в сапогах? Теперь увидишь, как они развиваются.", "weight": 1.4, "cooldown": 10, "min_move": 1, "max_move": 10 },
      { "id": "defender_opening_03", "text": "Чьё это поле? Маркиза Карабаса. Пока запишем так.", "weight": 1.5, "cooldown": 10, "min_move": 1, "max_move": 10 },
      { "id": "defender_opening_04", "text": "Хороший фехтовальщик сначала узнаёт длину клинка соперника.", "weight": 1.2, "cooldown": 9, "min_move": 1, "max_move": 10 }
    ],
    "middlegame": [
      { "id": "defender_middlegame_01", "text": "Теперь можно убрать улыбку и достать шпагу.", "weight": 1.4, "cooldown": 9 },
      { "id": "defender_middlegame_02", "text": "Вы наступали очень убедительно. Моя очередь.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_middlegame_03", "text": "Поле поделено. Маркиз Карабас, разумеется, недоволен.", "weight": 1.2, "cooldown": 9 }
    ],
    "endgame": [
      { "id": "defender_endgame_01", "text": "Меньше фигур, больше места для шпаги.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_endgame_02", "text": "Последний танец, сеньор. Не наступите на сапоги.", "weight": 1.3, "cooldown": 10 },
      { "id": "defender_endgame_03", "text": "В эндшпиле даже кот должен ходить прямо. Иногда.", "weight": 1.1, "cooldown": 9 }
    ],
    "thinking": [
      { "id": "defender_thinking_01", "text": "Хм... это не моё. Но позицию я всё же проверю.", "weight": 1.4, "cooldown": 9 },
      { "id": "defender_thinking_02", "text": "Он звучит мечтательно... Проверим, не блеф ли это.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_thinking_03", "text": "Кот смотрит спокойно. Шпага думает быстрее.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_thinking_04", "text": "Для тебя, детка, я могу быть кем угодно. Даже позиционным игроком.", "weight": 1.2, "cooldown": 10 },
      { "id": "defender_thinking_05", "text": "Сеньор, каждый выпад должен иметь путь назад.", "weight": 1.2, "cooldown": 9 },
      { "id": "defender_thinking_06", "text": "Терпение. Мышь сама выходит из укрытия.", "weight": 1.3, "cooldown": 9 }
    ],
    "choosing_plan": [
      { "id": "defender_choosing_plan_01", "text": "Можно защищаться. Можно сделать вид, что защищаешься.", "weight": 1.4, "cooldown": 10 },
      { "id": "defender_choosing_plan_02", "text": "Два пути. Один безопасный, другой — с плащом и шпагой.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_choosing_plan_03", "text": "Сначала улыбка. Затем выпад.", "weight": 1.4, "cooldown": 9 }
    ],
    "quiet_position": [
      { "id": "defender_quiet_position_01", "text": "Кот спокоен. Это должно вас насторожить.", "weight": 1.4, "cooldown": 9 },
      { "id": "defender_quiet_position_02", "text": "Шпага в ножнах не означает, что Кот безоружен.", "weight": 1.3, "cooldown": 9 },
      { "id": "defender_quiet_position_03", "text": "Мяу. Ничего не происходит. Пока.", "weight": 1.2, "cooldown": 9 }
