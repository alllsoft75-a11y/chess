      { "id": "sanguine_opponent_mistake_03", "text": "Ну, признайся, красиво же.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_opponent_mistake_04", "text": "Спасибо, дружище, я это возьму.", "weight": 1.0, "cooldown": 7 },
      { "id": "sanguine_opponent_mistake_05", "text": "Ой, извини. Нет, правда, извини.", "weight": 0.8, "cooldown": 8 },
      { "id": "sanguine_opponent_mistake_06", "text": "Ну вот, а ты боялся.", "weight": 0.9, "cooldown": 6 }
    ],
    "opponent_mistake_major": [
      { "id": "sanguine_opponent_mistake_major_01", "text": "Опа! Как тебе такое?", "weight": 1.0, "cooldown": 7 },
      { "id": "sanguine_opponent_mistake_major_02", "text": "Вот это я удачно зашёл.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_opponent_mistake_major_03", "text": "Ну что, ещё партию?", "weight": 0.7, "cooldown": 8 },
      { "id": "sanguine_opponent_mistake_major_04", "text": "Ха-ха! Я же говорил, что весело будет.", "weight": 1.0, "cooldown": 8 },
      { "id": "sanguine_opponent_mistake_major_05", "text": "Не расстраивайся, бывает.", "weight": 0.8, "cooldown": 7 }
