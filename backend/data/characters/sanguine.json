      { "id": "sanguine_draw_offer_03", "text": "По рукам?", "weight": 1.0, "cooldown": 8 }
    ],
    "draw_accepted": [
      { "id": "sanguine_draw_accepted_01", "text": "Ладно, ничья — тоже результат.", "weight": 1.0, "cooldown": 8 },
