      { "id": "sanguine_bad_position_03", "text": "Не стреляйте в пианиста — играет как умеет.", "weight": 0.8, "cooldown": 8 },
      { "id": "sanguine_bad_position_04", "text": "Хм. Ладно. Делаем что можем.", "weight": 1.0, "cooldown": 7 }
    ],
    "time_trouble_bad_position": [
      { "id": "sanguine_time_trouble_bad_position_01", "text": "Времени нет, позиция плохая, настроение отличное. Поехали.", "weight": 1.2, "cooldown": 8 },
      { "id": "sanguine_time_trouble_bad_position_02", "text": "Всё против меня. Тем интереснее.", "weight": 1.0, "cooldown": 8 }
