      { "id": "sanguine_own_mistake_04", "text": "Ха! Ну и глупость. С кем не бывает.", "weight": 1.0, "cooldown": 8 }
    ],
    "bad_position": [
      { "id": "sanguine_bad_position_01", "text": "Ещё не конец. Просто… уже почти.", "weight": 1.0, "cooldown": 8 },
