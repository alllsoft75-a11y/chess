  "dialogue": {
    "greeting": [
      { "id": "sanguine_greeting_01", "text": "Ну что, дружище, поехали?", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_greeting_02", "text": "Привет! Готов повеселиться?", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_greeting_03", "text": "Здравствуй. Надеюсь, будет интересно.", "weight": 0.8, "cooldown": 6 }
    ],
    "opening": [
      { "id": "sanguine_opening_01", "text": "Дебют — это разминка. Дальше — веселье.", "weight": 1.0, "cooldown": 6, "min_move": 1, "max_move": 10 },
      { "id": "sanguine_opening_02", "text": "Так, стандартно начнём, а потом похулиганим.", "weight": 1.0, "cooldown": 6, "min_move": 1, "max_move": 10 },
      { "id": "sanguine_opening_03", "text": "Поехали, посмотрим, кто кого переиграет.", "weight": 1.0, "cooldown": 6, "min_move": 1, "max_move": 10 }
    ],
    "middlegame": [
      { "id": "sanguine_middlegame_01", "text": "Вот теперь начинается настоящая игра.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_middlegame_02", "text": "Разминка закончена.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_middlegame_03", "text": "Ну-ка, что тут можно придумать…", "weight": 1.0, "cooldown": 6 }
    ],
    "endgame": [
      { "id": "sanguine_endgame_01", "text": "Эндшпиль. Тут я, если честно, скучаю.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_endgame_02", "text": "Ладно, доигрываем по-взрослому.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_endgame_03", "text": "Короли выходят погулять.", "weight": 1.0, "cooldown": 6 }
    ],
    "attack": [
      { "id": "sanguine_attack_01", "text": "Ну что, поехали?", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_02", "text": "Оп-па, тут интересно становится.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_03", "text": "Не зевай, я предупредил!", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_04", "text": "Вот это я люблю — живые шахматы!", "weight": 1.2, "cooldown": 7 },
      { "id": "sanguine_attack_05", "text": "Держись, сейчас будет весело.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_06", "text": "Опа! А вот и идея.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_07", "text": "Чувствуешь напряжение? Я тоже.", "weight": 0.9, "cooldown": 6 },
      { "id": "sanguine_attack_08", "text": "Ну-ка, ну-ка… что скажешь?", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_09", "text": "Инициатива у меня, и я её не отдам.", "weight": 0.8, "cooldown": 7 },
      { "id": "sanguine_attack_10", "text": "Слушай, а ведь красиво получается!", "weight": 1.1, "cooldown": 6 }
    ],
    "attack_strong": [
      { "id": "sanguine_attack_strong_01", "text": "Вот за это я и играю!", "weight": 1.2, "cooldown": 7 },
      { "id": "sanguine_attack_strong_02", "text": "Публика, внимание!", "weight": 0.8, "cooldown": 8 },
      { "id": "sanguine_attack_strong_03", "text": "Не жалко! Совсем не жалко!", "weight": 1.0, "cooldown": 7 },
      { "id": "sanguine_attack_strong_04", "text": "Красота требует жертв. Буквально.", "weight": 1.2, "cooldown": 8 },
      { "id": "sanguine_attack_strong_05", "text": "Ох, как мне это нравится.", "weight": 1.0, "cooldown": 6 }
    ],
    "attack_preparation": [
      { "id": "sanguine_attack_preparation_01", "text": "Так-так, накопим чуть-чуть.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_preparation_02", "text": "Пока подождём. Но недолго.", "weight": 1.0, "cooldown": 6 },
      { "id": "sanguine_attack_preparation_03", "text": "Разминка закончена, начинаем.", "weight": 1.0, "cooldown": 6 }
    ],
    "opponent_mistake": [
      { "id": "sanguine_opponent_mistake_01", "text": "Ой. Ты это видел?", "weight": 1.0, "cooldown": 6 },
